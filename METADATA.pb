name: "Leraw"
designer: "Hubert and Fischer, Iolite"
license: "OFL"
category: "SANS_SERIF"
date_added: "2026-09-27"
fonts {
  name: "Leraw"
  style: "normal"
  weight: 400
  filename: "Leraw[wght].ttf"
  post_script_name: "Leraw-Light"
  full_name: "Leraw Light"
  copyright: "Copyright 2015 The Rubik Project Authors (https://github.com/googlefonts/rubik). Sorani Kurdish extension: Copyright 2026 Iolite."
}
fonts {
  name: "Leraw"
  style: "italic"
  weight: 400
  filename: "Leraw-Italic[wght].ttf"
  post_script_name: "Leraw-LightItalic"
  full_name: "Leraw Light Italic"
  copyright: "Copyright 2015 The Rubik Project Authors (https://github.com/googlefonts/rubik). Sorani Kurdish extension: Copyright 2026 Iolite."
}
subsets: "arabic"
subsets: "latin"
subsets: "latin-ext"
axes {
  tag: "wght"
  min_value: 300.0
  max_value: 900.0
}
source {
  repository_url: "https://github.com/iolitetech/Leraw"
  files {
    source_file: "OFL.txt"
    dest_file: "OFL.txt"
  }
  files {
    source_file: "DESCRIPTION.en_us.html"
    dest_file: "DESCRIPTION.en_us.html"
  }
  files {
    source_file: "fonts/variable/Leraw[wght].ttf"
    dest_file: "Leraw[wght].ttf"
  }
  files {
    source_file: "fonts/variable/Leraw-Italic[wght].ttf"
    dest_file: "Leraw-Italic[wght].ttf"
  }
  branch: "main"
}
